<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base sin ActionBar -->
    <style name="Base.Theme.Finanzas" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Desactivar colores dinámicos -->
        <item name="isMaterial3DynamicColorApplied">false</item>

        <!-- Colores principales -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>

        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>

        <!-- Contenedores -->
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>

        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>

        <!-- Surface y variantes -->
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>

        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorSurfaceDim">@color/md_theme_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md_theme_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surfaceContainerHighest</item>

        <!-- Fondo global -->
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorPrimaryDark">@color/md_theme_background</item>

        <item name="android:statusBarColor">@color/md_theme_background</item>
        <item name="android:navigationBarColor">@color/md_theme_background</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <!-- Otros -->
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOutline">@color/md_theme_outline</item>

        <!-- Estilos de componentes -->
        <item name="materialButtonStyle">@style/Widget.Finanzas.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Finanzas.Card</item>
        <item name="textInputStyle">@style/Widget.Finanzas.TextInputLayout</item>
        <item name="autoCompleteTextViewStyle">@style/Widget.Finanzas.AutoCompleteTextView</item>
        <item name="android:autoCompleteTextViewStyle">@style/Widget.Finanzas.AutoCompleteTextView</item>
        <item name="chipStyle">@style/Widget.Finanzas.Chip</item>
        <item name="android:textViewStyle">@style/Widget.Finanzas.TextView</item>
        <item name="toolbarStyle">@style/Widget.Finanzas.Toolbar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Finanzas.MaterialAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Finanzas.BottomSheetDialog</item>

        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="Theme.Finanzas" parent="Base.Theme.Finanzas" />

    <style name="Widget.Finanzas.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/md_theme_background</item>
        <item name="titleTextColor">@color/md_theme_onSurface</item>
        <item name="subtitleTextColor">@color/md_theme_onSurfaceVariant</item>
        <item name="navigationIconTint">@color/md_theme_onSurface</item>
    </style>

    <style name="Widget.Finanzas.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.Finanzas.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/md_theme_secondaryContainer</item>
        <item name="android:textColor">@color/md_theme_onSecondaryContainer</item>
        <item name="iconTint">@color/md_theme_onSecondaryContainer</item>
    </style>

    <style name="Widget.Finanzas.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/md_theme_primary</item>
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="iconTint">@color/md_theme_primary</item>
    </style>

    <style name="Widget.Finanzas.Button.HomeAction" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/md_theme_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="iconTint">@color/md_theme_primary</item>
    </style>

    <style name="Widget.Finanzas.TextView" parent="android:Widget.TextView">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.Finanzas.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/md_theme_outline</item>
        <item name="boxBackgroundColor">@color/md_theme_surface</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="Widget.Finanzas.TextInputLayout.Dropdown" parent="Widget.Finanzas.TextInputLayout">
        <item name="android:minHeight">64dp</item>
        <item name="endIconMode">dropdown_menu</item>
        <item name="endIconTint">@color/md_theme_onSurfaceVariant</item>
        <item name="hintTextColor">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="Widget.Finanzas.AutoCompleteTextView" parent="">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">48dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:popupBackground">@drawable/bg_dropdown_popup</item>
        <item name="simpleItemSelectedColor">@color/md_theme_primaryContainer</item>
        <item name="simpleItemSelectedRippleColor">@color/md_theme_secondaryContainer</item>
    </style>

    <style name="Widget.Finanzas.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/md_theme_surface</item>
        <item name="strokeColor">@color/md_theme_outlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <style name="Widget.Finanzas.Card.HomeMetric" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/md_theme_surface</item>
        <item name="strokeColor">@color/md_theme_outlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <style name="ThemeOverlay.Finanzas.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceContainerHigh">@color/dialog_surface</item>
        <item name="colorSurfaceContainerHighest">@color/dialog_surface</item>
        <item name="android:colorBackground">@color/dialog_surface</item>
        <item name="backgroundTint">@color/dialog_surface</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Rounded.Large</item>
        <item name="materialAlertDialogTitlePanelStyle">@style/Widget.Finanzas.MaterialAlertDialog.Title.Panel</item>
        <item name="materialAlertDialogTitleIconStyle">@style/Widget.Finanzas.MaterialAlertDialog.Title.Icon</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Finanzas.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Finanzas.DialogBody</item>
    </style>

    <style name="ThemeOverlay.Finanzas.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorSurfaceContainerHigh">@color/dialog_surface</item>
        <item name="colorSurfaceContainerHighest">@color/dialog_surface</item>
        <item name="android:colorBackground">@color/dialog_surface</item>
        <item name="bottomSheetStyle">@style/Widget.Finanzas.BottomSheet</item>
    </style>

    <style name="Widget.Finanzas.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/dialog_surface</item>
        <item name="shapeAppearanceOverlay">@style/Shape.BottomSheet</item>
    </style>

    <style name="Widget.Finanzas.MaterialAlertDialog.Title.Panel" parent="MaterialAlertDialog.Material3.Title.Panel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.Finanzas.MaterialAlertDialog.Title.Icon" parent="MaterialAlertDialog.Material3.Title.Icon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="TextAppearance.Finanzas.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Finanzas.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
    </style>


    <style name="Widget.Finanzas.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="android:backgroundTint">@color/md_theme_secondaryContainer</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="chipStrokeColor">@color/md_theme_outline</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <style name="Widget.Finanzas.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:backgroundTint">@color/md_theme_secondaryContainer</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="chipStrokeColor">@color/md_theme_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconTint">@color/md_theme_primary</item>
    </style>

    <style name="Shape.Rounded.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Shape.Rounded.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Shape.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ThemeOverlay.Finanzas.ElevatedCard" parent="">
        <item name="cardUseCompatPadding">true</item>
    </style>

</resources>
