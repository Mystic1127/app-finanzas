<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="590dp"
    android:background="@color/planning_dialog_surface"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/goal_dialog_title_new"
                android:src="@drawable/ic_trackchanges"
                app:tint="@color/planning_dialog_icon" />

            <TextView
                android:id="@+id/tvGoalDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/goal_dialog_title_new"
                android:textColor="@color/planning_dialog_title"
                android:textSize="27sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/goal_dialog_section_basic"
            android:textColor="@color/planning_dialog_text"
            android:textSize="18sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Finanzas.PlanningTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/goal_field_title"
            app:startIconDrawable="@drawable/ic_flag">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalTitulo"
                style="@style/Widget.Finanzas.PlanningEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Finanzas.PlanningTextInputLayout.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/goal_field_currency"
            app:startIconDrawable="@drawable/ic_attach_money">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actGoalMoneda"
                style="@style/Widget.Finanzas.PlanningAutoCompleteTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Finanzas.PlanningTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/goal_field_target"
            app:startIconDrawable="@drawable/ic_savings">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalObjetivo"
                style="@style/Widget.Finanzas.PlanningEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Finanzas.PlanningTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/goal_field_current"
            app:startIconDrawable="@drawable/ic_account_balance_wallet">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalActual"
                style="@style/Widget.Finanzas.PlanningEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/goal_dialog_section_deadline"
            android:textColor="@color/planning_dialog_text"
            android:textSize="18sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Finanzas.PlanningTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/goal_field_deadline"
            app:startIconDrawable="@drawable/ic_calendar_month">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalFecha"
                style="@style/Widget.Finanzas.PlanningEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoalCancel"
                style="@style/Widget.Finanzas.PlanningDialogButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:text="@string/transactions_filter_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoalSave"
                style="@style/Widget.Finanzas.PlanningDialogButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/btn_guardar" />
        </LinearLayout>
</LinearLayout>
