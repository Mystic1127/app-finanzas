<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <EditText
        android:id="@+id/etReminderTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/reminder_field_title" />

    <EditText
        android:id="@+id/etReminderMonto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/reminder_field_amount"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/etReminderFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/reminder_field_due"
        android:inputType="date" />

    <EditText
        android:id="@+id/etReminderHora"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/reminder_field_time"
        android:inputType="time" />

    <EditText
        android:id="@+id/etReminderDias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/reminder_field_days"
        android:inputType="number" />

    <Spinner
        android:id="@+id/spReminderFrecuencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swReminderNotificar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/reminder_notify_label" />

</LinearLayout>
