<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowTransaction"
    android:orientation="horizontal"
    android:background="@drawable/bg_surface_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="84dp"
    android:padding="12dp">

    <View
        android:id="@+id/viewTransactionLabelColor"
        android:layout_width="5dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="10dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivTipo"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_wallet_24"
        app:tint="@color/income"/>

    <LinearLayout
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvTitulo"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvSub"
            android:alpha="0.8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
        android:id="@+id/tvTransactionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="12sp"
        android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMonto"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
