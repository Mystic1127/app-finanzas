<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeAnalysis"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="@dimen/screen_header_top"
        android:paddingEnd="20dp"
        android:paddingBottom="128dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/nav_analysis_title"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="@dimen/screen_header_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAnalysisPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Finanzas.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/analysis_income_expense_title"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAnalysisIncomeExpenseSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="6dp"
                            android:text="@string/chart_label_income_short"
                            android:textColor="@color/income"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_trending_up" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:drawablePadding="6dp"
                            android:text="@string/chart_label_expense_short"
                            android:textColor="@color/expense"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_expense" />
                    </LinearLayout>

                    <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                        android:id="@+id/chartAnalysisIncomeExpense"
                        android:layout_width="240dp"
                        android:layout_height="132dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:saveEnabled="false"
                        app:chartStyle="@style/Widget.Finanzas.VicoIncomeExpenseChart"
                        app:scrollEnabled="false"
                        app:zoomEnabled="false" />

                    <LinearLayout
                        android:id="@+id/listAnalysisIncomeExpenseAmounts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/tvAnalysisIncomeExpenseBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_alert_info"
                        android:padding="12dp"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAnalysisIncomeExpenseEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="18dp"
                        android:text="@string/analysis_empty_income_expense"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Finanzas.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_expense_category_title"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAnalysisCategoryBarsSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/analysis_categories_subtitle"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/listAnalysisCategoryBars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvAnalysisCategoryBarsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="18dp"
                        android:text="@string/analysis_empty_categories"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Finanzas.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/analysis_expense_trend_title"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAnalysisExpenseTrendSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/analysis_expense_trend_subtitle"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:textSize="13sp" />

                    <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                        android:id="@+id/chartAnalysisExpenseTrend"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="10dp"
                        android:saveEnabled="false"
                        app:chartStyle="@style/Widget.Finanzas.VicoExpenseLineChart"
                        app:scrollEnabled="false"
                        app:zoomEnabled="false" />

                    <LinearLayout
                        android:id="@+id/cardAnalysisExpenseTrendSingle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_alert_info"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/analysis_expense_trend_single_title"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAnalysisExpenseTrendSingle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/listAnalysisExpenseTrendMonths"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/tvAnalysisExpenseTrendEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="18dp"
                        android:text="@string/analysis_empty_expense_trend"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Finanzas.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/analysis_balance_title"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAnalysisBalanceSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/analysis_balance_subtitle"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAnalysisBalanceCurrent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAnalysisBalanceDelta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_chip"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:textColor="@color/income"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                        android:id="@+id/chartAnalysisBalance"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="10dp"
                        android:saveEnabled="false"
                        app:chartStyle="@style/Widget.Finanzas.VicoBalanceLineChart"
                        app:scrollEnabled="false"
                        app:zoomEnabled="false" />

                    <LinearLayout
                        android:id="@+id/listAnalysisBalanceMonths"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/tvAnalysisBalanceEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="18dp"
                        android:text="@string/analysis_empty_balance"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Finanzas.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/analysis_savings_title"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAnalysisSavingsSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:id="@+id/chartAnalysisSavings"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressAnalysisSavings"
                            android:layout_width="132dp"
                            android:layout_height="132dp"
                            android:layout_gravity="center"
                            android:indeterminate="false"
                            android:max="100"
                            app:indicatorColor="@color/income"
                            app:indicatorSize="132dp"
                            app:trackColor="@color/md_theme_outlineVariant"
                            app:trackThickness="12dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAnalysisSavingsPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/md_theme_onSurface"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAnalysisSavingsHero"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/analysis_savings_estimated"
                                android:textColor="@color/md_theme_onSurfaceVariant"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvAnalysisSavingsDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAnalysisSavingsMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_alert_info"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvAnalysisSavingsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="18dp"
                        android:text="@string/analysis_empty_savings"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAnalysisAssistant"
                style="@style/Widget.Finanzas.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAnalysisAssistantRisk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_chip"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:textColor="@color/risk_medium_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAnalysisAssistantSource"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/financial_assistant_title"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAnalysisAssistantSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/financial_assistant_subtitle"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvAnalysisAssistantSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_alert_info"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/financial_assistant_saving_label"
                                android:textColor="@color/md_theme_onSurfaceVariant"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAnalysisAssistantSaving"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:autoSizeMaxTextSize="19sp"
                                android:autoSizeMinTextSize="13sp"
                                android:autoSizeStepGranularity="1sp"
                                android:autoSizeTextType="uniform"
                                android:maxLines="1"
                                android:textColor="@color/income"
                                android:textSize="19sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_alert_info"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/financial_assistant_concern_label"
                                android:textColor="@color/md_theme_onSurfaceVariant"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAnalysisAssistantConcern"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:autoSizeMaxTextSize="16sp"
                                android:autoSizeMinTextSize="11sp"
                                android:autoSizeStepGranularity="1sp"
                                android:autoSizeTextType="uniform"
                                android:maxLines="2"
                                android:textColor="@color/md_theme_onSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAnalysisAssistantAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_alert_info"
                        android:padding="12dp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvAnalysisAssistantAlert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/expense"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAnalysisAssistantRefresh"
                        style="@style/Widget.Finanzas.Button.Secondary"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:text=""
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_refresh_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
