<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/screen_header_height"
        android:layout_marginStart="22dp"
        android:layout_marginTop="@dimen/screen_header_top"
        android:layout_marginEnd="22dp">

        <ImageView
            android:id="@+id/btnReportsBack"
            android:layout_width="@dimen/screen_header_icon"
            android:layout_height="@dimen/screen_header_icon"
            android:layout_gravity="start|center_vertical"
            android:padding="@dimen/screen_header_icon_padding"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/md_theme_onSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:text="@string/reports_title"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="@dimen/screen_header_title"
            android:textStyle="bold" />
    </FrameLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeReports"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="86dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportReportPdf"
                    style="@style/Widget.Finanzas.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reports_export_pdf"
                    app:icon="@drawable/ic_upload_24" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReportPreviousMonth"
                        style="@style/Widget.Finanzas.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/reports_previous_month"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_keyboard_arrow_left"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReportCurrentMonth"
                        style="@style/Widget.Finanzas.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/reports_current_month"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReportNextMonth"
                        style="@style/Widget.Finanzas.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/reports_next_month"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_keyboard_arrow_right"
                        app:iconGravity="textEnd" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvReportsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="16dp"
                    android:text="@string/reports_empty"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Finanzas.Card.HomeMetric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvReportPeriod"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvReportStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_status_chip"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:textColor="@color/risk_low_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:columnCount="2"
                            android:useDefaultMargins="true">

                            <TextView
                                android:id="@+id/tvReportIncome"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:background="@drawable/bg_alert_info"
                                android:padding="12dp"
                                android:textColor="@color/income"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvReportExpense"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:background="@drawable/bg_alert_info"
                                android:padding="12dp"
                                android:textColor="@color/expense"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvReportBalance"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:background="@drawable/bg_alert_info"
                                android:padding="12dp"
                                android:textColor="@color/chartBalance"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvReportCurrent"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:background="@drawable/bg_alert_info"
                                android:padding="12dp"
                                android:textColor="@color/md_theme_onSurface"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvReportScore"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:background="@drawable/bg_alert_info"
                                android:padding="12dp"
                                android:textColor="@color/md_theme_primary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvReportProjection"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:background="@drawable/bg_alert_info"
                                android:padding="12dp"
                                android:textColor="@color/md_theme_onSurface"
                                android:textStyle="bold" />
                        </GridLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReportToggleDetails"
                            style="@style/Widget.Finanzas.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="40dp"
                            android:text="@string/reports_view_more" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/reportDetailsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Finanzas.Card.HomeMetric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/reports_categories_title"
                            android:textColor="@color/md_theme_onSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvReportCategories"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/md_theme_onSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Finanzas.Card.HomeMetric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/reports_trend_title"
                            android:textColor="@color/md_theme_onSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvReportTrend"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/md_theme_onSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Finanzas.Card.HomeMetric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/reports_month_transactions_title"
                            android:textColor="@color/md_theme_onSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvReportTransactions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/md_theme_onSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressReports"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
