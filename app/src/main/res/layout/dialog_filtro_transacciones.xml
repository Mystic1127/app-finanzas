<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filterDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/transactions_filter_cd"
            android:src="@drawable/ic_filter"
            app:tint="@color/md_theme_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/transactions_filter_title"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/filterDialogScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="2dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Finanzas.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/transactions_filter_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFiltroTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/transactions_filter_dates"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Finanzas.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/transactions_filter_start">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFiltroInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Finanzas.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/transactions_filter_end">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFiltroFin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Finanzas.TextInputLayout.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/transactions_filter_category">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actFiltroCategoria"
                style="@style/Widget.Finanzas.AutoCompleteTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/transactions_filter_order"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgOrden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbOrdenFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/transactions_filter_order_date"
                android:textColor="@color/md_theme_onSurface" />

            <RadioButton
                android:id="@+id/rbOrdenNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transactions_filter_order_name"
                android:textColor="@color/md_theme_onSurface" />

            <RadioButton
                android:id="@+id/rbOrdenCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transactions_filter_order_category"
                android:textColor="@color/md_theme_onSurface" />
        </RadioGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swAscendente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/transactions_filter_sort_direction"
            android:textColor="@color/md_theme_onSurface" />

        <TextView
            android:id="@+id/tvFiltroEtiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/transactions_filter_label"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/scrollFiltroEtiquetas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipFiltroEtiquetas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true" />
        </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/filterDialogActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dialog_surface"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterCancel"
            style="@style/Widget.Finanzas.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:text="@string/transactions_filter_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterClear"
            style="@style/Widget.Finanzas.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="92dp"
            android:text="@string/transactions_filter_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterApply"
            style="@style/Widget.Finanzas.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="92dp"
            android:text="@string/transactions_filter_apply" />
    </LinearLayout>
</LinearLayout>
